#!/bin/sh
#
# 仅做“逻辑兜底”，不关 MT3000 同类服务（同 512MB 的 MT3000 能下发 IP，
# 说明根因不是“启动过重”，而是网口/DHCP 配置逻辑）。
#
# 1) 管理地址落到 192.168.5.1（iStoreOS 模板默认是 100.1）
# 2) 确保 dhcp.lan 开启（ignore 未置位）
# 3) 不改 br-lan/ports（交由 board.d 99-r1s-force-lan-wan + config_generate）
#

LOG=/etc/nanopi-net-boot.log
{
	date
	echo "board=$(cat /tmp/sysinfo/board_name 2>/dev/null || echo unknown)"
	echo "ifaces:"; ip -br link 2>/dev/null || true
	for p in /sys/class/net/*; do
		n=${p##*/}; [ "$n" = lo ] && continue
		d=$(basename "$(readlink -f "$p/device/driver" 2>/dev/null)" 2>/dev/null)
		echo "  $n driver=$d"
	done
	ls -la /lib/firmware/rtl_nic 2>/dev/null || echo "WARN: no /lib/firmware/rtl_nic"
	uci -q show network.lan 2>/dev/null || true
	uci -q show dhcp.lan 2>/dev/null || true
} >"$LOG" 2>&1

uci -q set network.lan.proto='static'
uci -q set network.lan.ipaddr='192.168.5.1'
uci -q set network.lan.netmask='255.255.255.0'

# 对齐对照机：br-lan.ports=eth1（USB r8152）；device 为空时兜底
if [ "$(uci -q get network.@device[0].name)" = "br-lan" ]; then
	uci -q delete network.@device[0].ports
	uci -q add_list network.@device[0].ports='eth1'
	uci -q set network.lan.device='br-lan'
elif [ -z "$(uci -q get network.lan.device)" ]; then
	uci -q set network.lan.device='eth1'
	echo "WARN: network.lan.device empty, set eth1" >>"$LOG"
fi

uci -q set dhcp.lan=dhcp
uci -q set dhcp.lan.interface='lan'
uci -q set dhcp.lan.start='100'
uci -q set dhcp.lan.limit='150'
uci -q set dhcp.lan.leasetime='12h'
uci -q delete dhcp.lan.ignore

uci -q commit network
uci -q commit dhcp

/etc/init.d/dnsmasq enable 2>/dev/null || true

{
	echo "--- after ---"
	uci -q show network.lan
	uci -q show dhcp.lan
} >>"$LOG" 2>&1

exit 0
