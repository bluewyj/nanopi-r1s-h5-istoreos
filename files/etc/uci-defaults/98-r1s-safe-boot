#!/bin/sh
#
# 对齐 MT3000：开启 zram；启用 USB-LAN 守护（对照可运行 ImmortalWrt）
#

if [ -x /etc/init.d/zram ]; then
	uci -q set system.@system[0].zram_size_mb='128'
	uci -q set system.@system[0].zram_comp_algo='lzo'
	uci -q commit system
	/etc/init.d/zram enable 2>/dev/null || true
fi

[ -x /etc/init.d/r1s-usb-lan ] && /etc/init.d/r1s-usb-lan enable 2>/dev/null || true

exit 0
