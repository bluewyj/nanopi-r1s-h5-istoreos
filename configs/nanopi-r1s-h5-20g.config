#
# ============================================================================
#  NanoPi R1S H5 —— iStoreOS 编译配置（20GiB 根分区版）
#  软件包与 nanopi-r1s-h5.config 相同；仅 ROOTFS_PARTSIZE=20480
#  同样打 squashfs + ext4（与 370m 一致）；TF 建议 ≥32GB
# ============================================================================
#

# ---------------------------------------------------------------------------
# 1. 目标平台（仅 R1S H5，其余对齐 MT3000 软件集）
# ---------------------------------------------------------------------------
CONFIG_TARGET_sunxi=y
CONFIG_TARGET_sunxi_cortexa53=y
CONFIG_TARGET_sunxi_cortexa53_DEVICE_friendlyarm_nanopi-r1s-h5=y
CONFIG_TARGET_MULTI_PROFILE=n
CONFIG_TARGET_PER_DEVICE_ROOTFS=n
CONFIG_TARGET_ALL_PROFILES=n

# ---------------------------------------------------------------------------
# 2. 镜像（与 370m 相同：squashfs + ext4 + gzip）
# ---------------------------------------------------------------------------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
# 20 GiB 根分区（OpenWrt 单位 MiB：20*1024=20480）
CONFIG_TARGET_ROOTFS_PARTSIZE=20480
CONFIG_TARGET_ROOTFS_UBIFS=n
CONFIG_TARGET_ROOTFS_INITRAMFS=n

# ---------------------------------------------------------------------------
# 3. iStoreOS 核心（与 MT3000 一致）
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci=y
# iStoreOS 24.10 用 luci-ssl（MT3000/21.02 的 luci-ssl-openssl 在此分支可能不存在）
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_luci-lib-fs=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_taskd=y

CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_quickstart=y
CONFIG_PACKAGE_luci-i18n-quickstart-zh-cn=y

CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-zh-cn=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

CONFIG_PACKAGE_luci-app-ota=y
CONFIG_PACKAGE_luci-i18n-ota-zh-cn=y

CONFIG_PACKAGE_luci-app-unishare=y
CONFIG_PACKAGE_unishare=y
CONFIG_PACKAGE_luci-i18n-unishare-zh-cn=y

CONFIG_PACKAGE_luci-app-linkease=y
CONFIG_PACKAGE_linkease=y
# linkease-common-bin 已并入 linkease（当前 nas-packages 无独立包；强选会被 defconfig 静默丢弃）
CONFIG_PACKAGE_luci-i18n-linkease-zh-cn=y

CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_ddnsto=y
CONFIG_PACKAGE_luci-i18n-ddnsto-zh-cn=y

CONFIG_PACKAGE_luci-app-filetransfer=y
CONFIG_PACKAGE_luci-i18n-filetransfer-zh-cn=y

CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y

# ---------------------------------------------------------------------------
# 4. 存储 / NAS（MT3000 有；无 Docker / MergerFS / OAF）
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y

CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y

CONFIG_PACKAGE_luci-app-cifs-mount=y
CONFIG_PACKAGE_cifsmount=y
CONFIG_PACKAGE_luci-i18n-cifs-mount-zh-cn=y

CONFIG_PACKAGE_luci-app-nfs=y
CONFIG_PACKAGE_nfs-utils=y
CONFIG_PACKAGE_nfs-kernel-server=y
CONFIG_PACKAGE_nfs-kernel-server-utils=y
CONFIG_PACKAGE_luci-i18n-nfs-zh-cn=y

CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_tune2fs=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_mdadm=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-cifs=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_usbutils=y

# ---------------------------------------------------------------------------
# 5. 软路由常用（与 MT3000 一致）
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y

CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_ddns-scripts_aliyun=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_avahi-dbus-daemon=y
CONFIG_PACKAGE_avahi-utils=y
CONFIG_PACKAGE_wget-ssl=y

CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_ip-full=y
# 24.10 默认 nft；保留 iptables-nft 兼容旧脚本（纯 iptables 包在 24.10 可能无效）
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-wireguard=y

# ---------------------------------------------------------------------------
# 6. 板级 + USB 网卡/上网（MT3000 亦含大量 usb-net；无板载 WiFi）
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
# 对齐 pudie88 seed：LAN 在 EHCI/USB2 上的 RTL8153，必须带上 usb2 主机栈
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_r8152-firmware=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y

# ---------------------------------------------------------------------------
# 7. 构建加速（CCACHE 依赖 DEVEL；缺 DEVEL 时会被 defconfig 静默丢弃）
# ---------------------------------------------------------------------------
CONFIG_DEVEL=y
CONFIG_CCACHE=y
